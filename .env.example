# ==============================================================================
# نمونه تنظیمات محیطی و پایگاه‌داده MySQL هاست (cPanel / DirectAdmin)
# فایل: .env.example
# ==============================================================================

# اتصال به دیتابیس MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sahmnazr_campaign
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# کلید امنیتی توکن‌های مدیریت
APP_SECRET=your_random_secure_secret_key_here

# تنظیمات محیط توسعه و دیباگ
DISABLE_HMR=true
HOST=0.0.0.0
